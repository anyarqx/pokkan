{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pokkan-web",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "pokkan.net",
      "custom_domain": true
    }
  ]
}
