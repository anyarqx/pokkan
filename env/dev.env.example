# Local Rails development. Copy to env/dev.env; never commit it.
RAILS_ENV=development
RAILS_LOG_LEVEL=debug
DB_ADAPTER=mysql2

# Optional: use a complete MySQL connection URL instead of the DB_* fields.
DB_HOST=127.0.0.1

# compose.yaml exposes local MySQL on 3308 to avoid a host-MySQL conflict.
DB_PORT=3308
DB_NAME=pokkan_the_bot_development
DB_TEST_NAME=pokkan_the_bot_test
DB_USER=pokkan

# Local-only value shared with compose.yaml; use a private value outside local development.
DB_PASSWORD=pokkan-local-only
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required server-side Discord OAuth configuration. The redirect must exactly
# match the callback registered in Discord for this local Rails API.
REDIRECT_AUTH_URL=http://localhost:3000/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

VITE_API_ORIGIN=
VITE_SUPPORT_URL=https://discord.gg/yDvayp7tgg
VITE_YOUTUBE_URL=https://youtube.com/@pokkanbot
VITE_GITHUB_URL=https://github.com/PokkanBot
VITE_CREATOR_LABEL=serene1491
