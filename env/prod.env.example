# Square Cloud private Rails environment. Copy outside Git; never upload it.
RAILS_ENV=production

# Required. Keep a unique long random value only in Square Cloud's private
# environment and rotate it after any exposure.
SECRET_KEY_BASE=
RAILS_LOG_LEVEL=info
API_HOST=pokkan.squareweb.app
FRONTEND_ORIGIN=https://pokkan.net
FRONTEND_ORIGINS=https://pokkan.net

# Square Cloud intentionally uses SQLite, not MySQL.
DB_ADAPTER=sqlite3
SQLITE_DATABASE=storage/pokkan_the_bot_production.sqlite3
SQLITE_TIMEOUT=5000

# Required server-side Discord OAuth configuration. The redirect must exactly
# match the callback registered in Discord for this Square Cloud API.
REDIRECT_AUTH_URL=https://pokkan.squareweb.app/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Public build configuration only.
VITE_API_ORIGIN=https://pokkan.squareweb.app
VITE_SUPPORT_URL=https://discord.gg/yDvayp7tgg
VITE_YOUTUBE_URL=https://youtube.com/@pokkanbot
VITE_GITHUB_URL=https://github.com/PokkanBot
VITE_CREATOR_LABEL=serene1491

# Deployment metadata used by local scripts/CI, never exposed to Vite.
SQUARE_APP_ID=
